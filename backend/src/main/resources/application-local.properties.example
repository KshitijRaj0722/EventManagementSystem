# Copy this file to application-local.properties (which is git-ignored) and fill in
# your local secrets. The default "local" profile loads application-local.properties
# automatically, so `./mvnw spring-boot:run` just works against your local DB.
#
# This example assumes local MySQL. (Production deploys to PostgreSQL via env vars.)
spring.datasource.url=jdbc:mysql://localhost:3306/eventhubdb?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=YOUR_LOCAL_MYSQL_PASSWORD
app.jwt.secret=any-long-random-string-at-least-32-characters
